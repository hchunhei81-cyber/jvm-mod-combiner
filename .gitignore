# --- Rust build output and compiled Java classes ---
# Cargo's build directory and compiled classes are generated artifacts.
target/
*.class

# --- Python build output and virtual environments ---
# Python's build directory and virtual environments are generated artifacts.
__pycache__/

# --- Node.js dependencies ---
# Dependencies can be recreated from the package manifest and lockfile.
node_modules/

