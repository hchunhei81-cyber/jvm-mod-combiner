# --- Rust build output and compiled Java classes ---
# Cargo's build directory and compiled classes are generated artifacts.
target/
*.class

# --- Runtime diagnostics and generated data ---
# Keep crash reports, logs, and data files out of version control.
crash-reports/
logs/
*.log
*.dat
*.dat.*

# --- Local machine, environment, and editor files ---
# These files can contain machine-specific settings or local environment data.
.DS_Store
.env
bus_test/build/
bus_test/bus-agent.jar

# --- Temporary and editor-created backups ---
# Cover common backup suffixes without excluding ordinary source files.
*.bak.*
*.bak
*.bakup
*.bakup.*
backups/

# --- Local Minecraft sandbox and save data ---
# The sandbox and saves are local runtime data, not project sources.
sandbox/
saves/

# --- Explicit sandbox dependency and runtime paths ---
# Retain these entries as documentation of large generated files and folders.
sandbox/minecraft-client.jar
sandbox/forge_env/libraries/net/minecraft/client/
sandbox/forge_env/libraries/de/oceanlabs/mcp/
sandbox/forge_env/versions/1.21.4/
sandbox/mc_libraries/

# --- Local installers, launch scripts, and native runtime files ---
# These are downloaded or machine-specific files used to launch the game.
forge-installer.jar
forge-installer.jar.log.DS_Store
*.current
natives-lwjgl-331/
natives-lwjgl-331-x64/
backups/
forge_1165_launch.sh
neoforge_launch.sh

# --- Tool metadata, local caches, and project-specific temporary files ---
# Exclude generated metadata, command history, downloads, and helper scripts.
.fabric/
usercache.json
command_history.txt
downloads/
others/
