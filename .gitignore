# --- Tool metadata, local caches, and project-specific temporary files ---
# Exclude generated metadata, command history, downloads, and helper scripts.
.fabric/
usercache.json
command_history.txt
downloads/
others/

# --- Supabase local development & Edge Functions ---
# Keep local Supabase configs, temp data, and secrets out of version control.
